# ===========================================================================
# .editorconfig — UDAP .NET v2 Roslyn tanı şiddet eşlemeleri
#
# Şiddet modeli (bkz. .agents/rules/01-squad-handoff-protocol.md):
#   S1 -> error       (build kırar, tolerans yok)
#   S2 -> warning     (PR bloklar; Directory.Build.props/WarningsNotAsErrors sayesinde
#                      TreatWarningsAsErrors bunları build hatasına çevirmez)
#   S3 -> suggestion  (bilgilendirme)
#
# Buradaki her tanı kodu .agents/rules_registry.yaml içindeki bir kurala bağlıdır;
# eşleşme `bash .agents/verify.sh` tarafından doğrulanır.
# ===========================================================================
root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# C# Language rules
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning

# ---------------------------------------------------------------------------
# UDAP Rule Mappings
# ---------------------------------------------------------------------------
# R-SOLID-008 (S2): Metot karmaşıklık <= 10
dotnet_diagnostic.S1541.severity = warning
# R-SOLID-009 (S2): Bilişsel karmaşıklık <= 15
dotnet_diagnostic.S3776.severity = warning
# R-SOLID-011 (S3): İç içe koşul derinliği <= 3
dotnet_diagnostic.S134.severity = suggestion
# R-NET-001 (S1): Senkron Task bloklama
dotnet_diagnostic.VSTHRD002.severity = error
# R-NET-002 (S1): async void yasağı
dotnet_diagnostic.VSTHRD100.severity = error
# R-NET-003 (S2): ConfigureAwait(false)
dotnet_diagnostic.CA2007.severity = warning
# R-NET-005 (S3): Task Async soneki
dotnet_diagnostic.VSTHRD200.severity = suggestion
# R-NET-007 (S1): IDisposable using zorunluluğu
dotnet_diagnostic.CA2000.severity = error
# R-NET-008 (S1): ValueTask tek await
dotnet_diagnostic.CA2012.severity = error
# R-NET-009 (S1): Awaitsiz Task dönüşü
dotnet_diagnostic.CS4014.severity = error
# R-AUTH-009 (S1): Antiforgery token zorunluluğu
dotnet_diagnostic.S4507.severity = error
# R-CRY-001 (S1): Zayıf kripto MD5/SHA1
dotnet_diagnostic.CA5350.severity = error
# R-CRY-002 (S1): ECB şifreleme modu yasağı
dotnet_diagnostic.CA5358.severity = error
# R-CRY-003 (S1): Random kripto yasağı
dotnet_diagnostic.CA5394.severity = error
# R-CRY-005 (S1): Sertifika doğrulama bypass yasağı
dotnet_diagnostic.CA5359.severity = error
# R-NET-050 (S1): BannedSymbols DateTime.Now yasağı
dotnet_diagnostic.RS0030.severity = error
# R-NET-051 (S2): Kültüre duyarlı işlem CA1304
dotnet_diagnostic.CA1304.severity = warning
# R-SOLID-005 (S2): Türetilmeyen public sınıflar sealed olmalı
dotnet_diagnostic.S3260.severity = warning
# R-SOLID-007 (S2): Constructor/metot parametre sayısı <= 5
dotnet_diagnostic.S107.severity = warning
# R-SOLID-010 (S3): Metot <= 60 satır
dotnet_diagnostic.S138.severity = suggestion
# R-SOLID-010 (S3): Dosya/sınıf <= 400 satır
dotnet_diagnostic.S104.severity = suggestion
# R-SOLID-012 (S2): Kalıtım derinliği <= 3
dotnet_diagnostic.S110.severity = warning

# ---------------------------------------------------------------------------
# Sonar eşik parametreleri (analizör varsayılanları UDAP limitlerine çekilir)
# .agents/contract.yaml -> limits bölümüyle aynı tutulmalıdır.
# ---------------------------------------------------------------------------
dotnet_diagnostic.S1541.threshold = 10
dotnet_diagnostic.S3776.threshold = 15
dotnet_diagnostic.S107.max = 5
dotnet_diagnostic.S138.max = 60
dotnet_diagnostic.S104.maximumFileLocThreshold = 400
dotnet_diagnostic.S110.maximumDepth = 3

# ---------------------------------------------------------------------------
# Test projeleri: üretim kodu kuralları test kodunda gevşetilmez, ancak
# xUnit isimlendirmesi (CA1707) ve örnek erişimi (CA1822) istisna tutulur.
# ---------------------------------------------------------------------------
[**/{*Tests,*Test,tests}/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.S2325.severity = none
