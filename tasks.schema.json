{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Squad Task Queue Schema",
  "description": "JSON Schema for tasks.json in the Agent Squad autonomous software development lifecycle",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "description",
      "status",
      "priority",
      "dependencies",
      "assignedSquad",
      "dorMet",
      "dodMet",
      "artifacts"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^TASK-[0-9]+$",
        "description": "Unique task identifier (e.g. TASK-01)"
      },
      "title": {
        "type": "string",
        "description": "Concise task summary"
      },
      "description": {
        "type": "string",
        "description": "Detailed business and architectural requirements"
      },
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "in_progress",
          "in_review",
          "changes_requested",
          "blocked",
          "completed"
        ],
        "description": "Current lifecycle state of the atomic task"
      },
      "priority": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"],
        "description": "Task execution priority"
      },
      "dependencies": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Task IDs that must reach 'completed' state before this task can start"
      },
      "assignedSquad": {
        "type": "object",
        "required": [
          "orchestrator",
          "analyst",
          "architect",
          "ux",
          "developers",
          "reviewers"
        ],
        "properties": {
          "orchestrator": {
            "type": "string",
            "default": "project-manager"
          },
          "analyst": {
            "type": "string",
            "default": "business-analyst"
          },
          "architect": {
            "type": "string",
            "default": "solution-architect"
          },
          "ux": {
            "type": "string",
            "default": "uiux-designer"
          },
          "developers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "dorMet": {
        "type": "boolean",
        "description": "Definition of Ready gate approval before in_progress"
      },
      "dodMet": {
        "type": "boolean",
        "description": "Definition of Done gate approval before completed"
      },
      "rejectionCount": {
        "type": "integer",
        "minimum": 0,
        "default": 0,
        "description": "Number of times this task was sent back for revision"
      },
      "reviewNotes": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [],
        "description": "Audit notes, revision requests or blocker details"
      },
      "artifacts": {
        "type": "object",
        "required": [
          "userStory",
          "acceptanceCriteria",
          "architectureDecisions",
          "designPatternsUsed",
          "uiDesignTokens",
          "testsWritten",
          "securityAuditPassed"
        ],
        "properties": {
          "userStory": {
            "type": "string"
          },
          "acceptanceCriteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "architectureDecisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "designPatternsUsed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of GoF / Enterprise Design Patterns implemented in this task"
          },
          "uiDesignTokens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testsWritten": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "securityAuditPassed": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
