<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Hedef çerçeve kökteki Directory.Build.props üzerinden merkezî yönetilir (R-NET-062). -->
    <TargetFramework>$(SquadTargetFramework)</TargetFramework>
    <RootNamespace>Company.ArchitectureTests</RootNamespace>
    <AssemblyName>Company.ArchitectureTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: fixture tiplerinde XML dokümantasyonu zorunlu değildir. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.11.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    Hedef projeye uyarlanırken denetlenecek ürün projeleri buraya eklenir; böylece
    ArchitectureRulesTests.ProductAssemblies() gerçek katmanları yükleyebilir.
    Örnek:
    <ItemGroup>
      <ProjectReference Include="..\..\src\Company.Domain\Company.Domain.csproj" />
      <ProjectReference Include="..\..\src\Company.Application\Company.Application.csproj" />
      <ProjectReference Include="..\..\src\Company.Infrastructure\Company.Infrastructure.csproj" />
      <ProjectReference Include="..\..\src\Company.Api\Company.Api.csproj" />
    </ItemGroup>
  -->

</Project>
