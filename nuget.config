<?xml version="1.0" encoding="utf-8"?>
<!--
  R-SUP-003: NuGet kaynak allowlist'i.

  packageSourceMapping bir ALLOWLIST'tir: burada eşlenmeyen hiçbir paket desenini
  restore edemezsiniz. Tek kaynağa "*" eşlemek allowlist'i etkisiz kılar; bu yüzden
  dahili paketler (Company.*) yalnızca dahili feed'den, üçüncü taraf paketler
  yalnızca nuget.org'dan gelecek şekilde ayrıştırılmalıdır (dependency confusion
  saldırısına karşı birincil savunma).

  Hedef projeye uyarlarken: dahili feed'i açın ve kendi paket önekinizi yazın.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- <add key="internal-feed" value="https://pkgs.company.local/v3/index.json" /> -->
  </packageSources>

  <packageSourceMapping>
    <!--
      Dahili paket öneki daima ÖNCE ve yalnızca dahili feed'e eşlenir.
      <packageSource key="internal-feed">
        <package pattern="Company.*" />
      </packageSource>
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- R-SUP-004: Paket imza doğrulaması -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <trustedSigners>
    <author name="microsoft">
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE"
                   hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </author>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="5A2901D6ADA3D18260B9C6DFE2133C95D74B9EEF6AE0E5DC334C8454D1477DF4"
                   hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <owners>*</owners>
    </repository>
  </trustedSigners>
</configuration>
