{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "mutate": [
      "src/*/Domain/**",
      "src/*/Application/**",
      "!**/*.Generated.cs",
      "!**/*.g.cs",
      "!**/Migrations/**",
      "!**/Dtos/**"
    ],
    "solution": "agent-squad.sln",
    "test-projects": [
      "tests/**/*.Tests.csproj",
      "tests/**/*.UnitTests.csproj"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html",
      "json"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "since": {
      "enabled": true,
      "target": "origin/main",
      "ignore-changes-in": [
        "**/*.md",
        "**/*.json",
        "**/*.yaml",
        "**/*.yml"
      ]
    },
    "mutation-level": "Standard",
    "concurrency": 4
  }
}
